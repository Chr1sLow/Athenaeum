# Copy this file to .env and change POSTGRES_PASSWORD (and the matching part of both URLs).

# --- Postgres (used by docker-compose.yml) ---
POSTGRES_USER=athenaeum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=athenaeum
POSTGRES_PORT=5432

# --- Server ---
DATABASE_URL=postgres://athenaeum:change-me@127.0.0.1:5432/athenaeum
TEST_DATABASE_URL=postgres://athenaeum:change-me@127.0.0.1:5432/athenaeum_test
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from other devices on your network.
HOST=127.0.0.1
PORT=3001
# The address you open in the browser. Used for the cross-site request check and secure cookies.
APP_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=200
ALLOW_SIGNUP=true
